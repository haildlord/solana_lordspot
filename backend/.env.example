# Server
PORT=3000
NODE_ENV=development

# Postgres + Redis (docker-compose defaults)
DATABASE_URL=postgresql://postgres:admin@123@localhost:5432/lordspot_db?schema=public
REDIS_URL=redis://127.0.0.1:6379

# Solana
SOLANA_RPC_URL=
SOLANA_PROGRAM_ID=
LORDSPOT_VAULT_ADDRESS=
SOLANA_VAULT_USDC_ATA=
SOLANA_PRIVATE_KEY=

# Base (84532 = Sepolia, 8453 = mainnet)
# BASE_RPC_URL preferred; ANVIL_RPC_URL also accepted (local anvil)
BASE_RPC_URL=
BASE_CHAIN_ID=84532
LORDSPOT_BASE_VAULT=
RELAYER_BASE_SIGNER_PRIVATEKEY=
BASE_REWARD_WALLET_ADDRESS=
REFERRAL_SPLIT=1000000000000000000
MIN_BASE_VAULT_USDC=100000000
USDC_BASE_ADDRESS=

# Megapot
MEGAPOT_API_KEY=
MEGAPOT_API_URL=https://api.megapot.io/v1

# Helius webhook (optional HMAC verification)
HELIUS_WEBHOOK_SECRET=
