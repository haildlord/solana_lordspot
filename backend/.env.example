# Server
PORT=3000
NODE_ENV=development

# Postgres + Redis (docker-compose defaults)
DATABASE_URL=postgresql://postgres:admin@123@localhost:5432/lordspot_db?schema=public
REDIS_URL=redis://127.0.0.1:6379

# DIRECT_DATABASE_URL — REQUIRED whenever Postgres sits behind a connection
# pooler (Supabase, Neon, any PgBouncer setup). Leave unset for plain local
# Postgres: prisma.config.ts falls back to DATABASE_URL.
#
# Why two URLs: `prisma migrate` takes a Postgres advisory lock that has to live
# on ONE session for the whole migration. A pooler can hand each query a
# different session, so the lock is taken on one and checked on another — it
# hangs, then times out. Migrations therefore need a NON-pooled (or session-mode)
# connection, while the app itself wants the pooled one.
#
# Supabase (both from Connect, note the DIFFERENT ports):
#   DATABASE_URL        -> transaction pooler, port 6543   (the app)
#   DIRECT_DATABASE_URL -> session pooler,     port 5432   (migrations)
#
# Append ?sslmode=no-verify to BOTH. Supabase requires SSL, but its pooler
# presents a certificate node-postgres cannot verify against Node's built-in CA
# list — `sslmode=require` fails with "self-signed certificate in certificate
# chain" (Prisma P1011). `no-verify` still encrypts; it only skips checking who
# issued the certificate. Do NOT add ?pgbouncer=true: that flag is read by
# Prisma's own query engine, which this project bypasses via @prisma/adapter-pg.
#
# Avoid Supabase's "Direct connection" string — it is IPv6-only on new projects
# and fails from hosts without IPv6 egress.
DIRECT_DATABASE_URL=

# Solana
SOLANA_RPC_URL=
SOLANA_PROGRAM_ID=
LORDSPOT_VAULT_ADDRESS=
SOLANA_VAULT_USDC_ATA=
SOLANA_PRIVATE_KEY=

# Base (84532 = Sepolia, 8453 = mainnet)
# BASE_RPC_URL preferred; ANVIL_RPC_URL also accepted (local anvil)
BASE_RPC_URL=
BASE_CHAIN_ID=84532
LORDSPOT_BASE_VAULT=
RELAYER_BASE_SIGNER_PRIVATEKEY=
BASE_REWARD_WALLET_ADDRESS=
REFERRAL_SPLIT=1000000000000000000
MIN_BASE_VAULT_USDC=100000000
USDC_BASE_ADDRESS=

# Megapot
MEGAPOT_API_KEY=
MEGAPOT_API_URL=https://api.megapot.io/v1

# Helius webhook (optional HMAC verification)
HELIUS_WEBHOOK_SECRET=
